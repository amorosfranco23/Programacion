@startuml

class Paciente{
-dni: String
-nombreCompleto: String
-fechaNacimiento: date
-sexo: String
-direccion: String
-numeroTelefonico: String
-correoElectronico: String
-contactoEmergencia: String
+registrarLlegada()
+actualizarDatos()
+solicitarBaja()
}

class Medico{
-nombre: String
-especialidad: String
+accederHistoriaClinica()
+agregarDiagnostico()
+agregarTratamientos()

}

class PersonalAdministrativo{
-nombre: String
+verificarLlegada()
+ingresarPaciente()
+asignarNumeroHistoria()
+modificarDatos()
+gestionarBaja()
}

class RegistroMedico{
-fechaRegistro: date
-diagnostico: String
-tratamiento: String
+notificarFacturacion()
}


class HistoriaClinica{
-numeroHistoriaClinica: int
-enfermedadesPrevias:  String
-alergias: String
-intervencionesQuirurgicas: String
-enfermedadesCronicas: String
-medicacion: String
-estado: String
+sugerirHistorial()
}

Paciente "1" -- "1" HistoriaClinica : posee >
HistoriaClinica "1" *-- "0..*" RegistroMedico : contiene >
Medico ..> HistoriaClinica : consulta
Medico ..> RegistroMedico : genera
PersonalAdministrativo ..> Paciente : registra
PersonalAdministrativo ..> HistoriaClinica : crea/modifica
@enduml
